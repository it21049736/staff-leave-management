SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: sqlite is used by default for local dev.
# To switch to PostgreSQL, set DB_ENGINE=postgres and fill in the values below.
DB_ENGINE=sqlite
DB_NAME=leave_db
